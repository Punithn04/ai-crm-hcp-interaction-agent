{
  // Cloudflare Worker that serves the built React frontend as static assets.
  // The FastAPI + LangGraph backend is NOT deployed here (Cloudflare Workers
  // can't run it) — deploy that separately (Render/Railway/Fly.io) and point
  // the frontend's API base URL at it.
  "name": "aivoa-assignment",
  "compatibility_date": "2024-11-01",
  "assets": {
    "directory": "./frontend/dist",
    "not_found_handling": "single-page-application"
  }
}
